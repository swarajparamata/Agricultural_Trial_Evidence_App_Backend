# Copy to `.env` (Windows: copy .env.example .env) and adjust. Every value has a working default.

# SQLite file in ./data by default. Any SQLAlchemy URL works (e.g. postgresql+psycopg://...).
# DATABASE_URL=sqlite:///./data/agritrial.db

# Signs login tokens. Leave empty in development: a random key is generated once into data/.secret_key.
# Set a long random value in production.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720

# The React dev server's address(es), comma separated.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo mode: seeds admin@agrievidence.demo / admin123 and viewer@agrievidence.demo / viewer123,
# imports the sample data on first start, shows the accounts on the login page and allows "Reset demo".
DEMO_MODE=true
# Defaults to the workspace's ../sample-data folder, or the copy in ./demo_data.
SAMPLE_DATA_DIR=

# Outside demo mode: the first admin, created when the database has no users.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# The separate LLM service (Agricultural_Trial_Evidence_App_LLM).
LLM_SERVICE_URL=http://127.0.0.1:8100
# Must match the LLM service's LLM_SERVICE_API_KEY when that is set.
LLM_SERVICE_API_KEY=
LLM_SERVICE_TIMEOUT_S=300

UPLOAD_MAX_BYTES=5000000
